NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecomsite
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379
JWT_SECRET=replace-with-at-least-32-characters-secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dronqxmli
RAZORPAY_KEY_ID=your-razorpay-api-key
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
EMAIL_USER=yourmail@mail.com
EMAIL_PASS=your-app-password
