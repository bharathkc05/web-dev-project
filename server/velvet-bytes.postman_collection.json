            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/users?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "role",
                  "value": "CUSTOMER",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Get all users. Admin authentication required."
          }
        },
